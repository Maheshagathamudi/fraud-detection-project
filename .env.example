app_name=Real-Time Fraud Detection API
environment=development
api_v1_prefix=/api/v1
log_level=INFO
cors_origins=*
database_url=sqlite:///./fraud_detection.db
# Optional Redis URL for shared rate counters and the outbox worker.
# redis_url=redis://localhost:6379/0
high_amount_threshold=2500.00
customer_velocity_limit=5
instrument_velocity_limit=3
approve_threshold=30
decline_threshold=70
# Optional trusted joblib artifact; leave blank to use rules only.
# model_artifact_path=
